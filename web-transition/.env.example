# Origen del backend (middleware). Opcional.
# Si se define, sobreescribe la selección automática dev/producción.
#
# Local:
#   VITE_BACKEND_ORIGIN=http://localhost:8080
#
# Producción (Vercel / build):
#   VITE_BACKEND_ORIGIN=https://backend-middleware-habitar-inmobiliaria-production.up.railway.app
# Si no se define en prod, el default de config.ts ya apunta a Railway.
VITE_BACKEND_ORIGIN=

# Base pública de assets en el build de Vercel (la pone scripts/vercel-build.mjs).
# No hace falta definirla a mano en local.
# VITE_BASE=/react/
